# Server-side secrets only. Never place private service-account keys in browser code.
# Example Firebase Functions configuration (set real values in the hosting provider):
# PAYMENT_PROVIDER_SECRET=
# TURN_SERVER_URL=
# TURN_SERVER_USERNAME=
# TURN_SERVER_CREDENTIAL=

# Optional WebRTC relay (TURN). Use a provider that supports coturn REST credentials.
# Comma-separated TURN URLs, e.g. turns:turn.example.net:443?transport=tcp
TURN_SERVER_URL=
# Shared secret used only by Firebase Functions to mint 1-hour temporary credentials.
TURN_SHARED_SECRET=
